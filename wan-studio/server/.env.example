DATABASE_URL=postgres://wan:wan@localhost:5433/wanstudio
JWT_SECRET=cambia-este-secreto-por-algo-largo-y-aleatorio
PORT=4100
# Dominio público (para las URLs de video en los webhooks), p. ej. https://wan-studio.up.railway.app
PUBLIC_URL=
# Carpeta de videos e imágenes. En Railway, la ruta de un volumen montado.
DATOS_DIR=

# Cuentas
REGISTRO_ABIERTO=true
CREDITOS_INICIALES=20
MAX_PENDIENTES_POR_USUARIO=5
# Duración máxima de un video en segundos (Wan rinde mejor hasta ~5 s)
DURACION_MAX=10
# Correos con acceso sin límites (además de la primera cuenta registrada)
ADMIN_EMAILS=

# Motor: mock | comfyui | runpod | fal
MOTOR=mock
TRABAJOS_SIMULTANEOS=1
TRABAJO_LIMITE_MIN=30
MOCK_DEMORA_MS=4000

# --- comfyui (tu GPU o un pod) ---
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TOKEN=
# a14b = Wan 2.2 A14B (nube) · 5b = Wan 2.2 TI2V 5B (RTX 4050)
COMFYUI_FAMILIA=5b
# LoRA de aceleración opcional (lightx2v); deja vacío para no usarla
COMFYUI_LORA_RAPIDA=
COMFYUI_LORA_RAPIDA_ALTO=
COMFYUI_LORA_RAPIDA_BAJO=
# true para modelos .gguf cuantizados (requiere el paquete ComfyUI-GGUF)
COMFYUI_GGUF=false
# Nombres de modelo si los tuyos son distintos (ver motores/flujosComfy.js)
# COMFYUI_MODELO_5B=wan2.2_ti2v_5B_fp16.safetensors   (o p. ej. Wan2.2-TI2V-5B-Q5_K_M.gguf)
# COMFYUI_VAE_5B=wan2.2_vae.safetensors
# COMFYUI_TEXTO=umt5_xxl_fp8_e4m3fn_scaled.safetensors

# --- runpod (serverless) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# --- fal.ai ---
FAL_KEY=
