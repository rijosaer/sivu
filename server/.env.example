DATABASE_URL=postgres://invitacion:invitacion@localhost:5432/invitacion
# Mínimo 32 caracteres aleatorios: openssl rand -base64 48
# En producción el servidor no arranca con el valor de ejemplo.
JWT_SECRET=cambia-este-secreto-por-algo-largo-y-aleatorio
PORT=4000

# Orígenes extra que pueden llamar a la API desde un navegador, separados por
# coma (heysivu.com, www y panel.heysivu.com ya vienen incluidos).
# Ej.: CORS_ORIGINS=https://panel-pruebas-production.up.railway.app
CORS_ORIGINS=

# 1 = rechazar lo que no llegue a través de Cloudflare (evita que se salten
# el WAF llamando a Railway directo). Actívalo cuando api.heysivu.com esté
# con la nube naranja (proxied) en Cloudflare.
SOLO_CLOUDFLARE=
